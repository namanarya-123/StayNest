<style>
  .btn-search{
    background-color: #fe424d;
    color: white;
    border-radius: 30px;
    padding: 0 1rem 0 1rem;
  }
  .btn-search:hover{
    background-color: #fe424d;
    color: white;
  }
  .btn-search{
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-search i {
    display: inline;
    margin-right: 0.5rem;
    font-size: 0.8rem;
  }
  .search-inp{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }

  /* profile avatar */
  .profile-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #E8453C;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    border: none;
    outline: none;
  }
  .profile-btn {
    background: transparent;
    border: 1.5px solid #EDEAE5;
    border-radius: 999px;
    padding: 4px 10px 4px 6px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: box-shadow 0.2s;
  }
  .profile-btn:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.12); }
  .profile-btn .hamburger { font-size: 14px; color: #555; }

  .profile-dropdown {
    border-radius: 14px !important;
    border: 1px solid #EDEAE5 !important;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1) !important;
    min-width: 200px !important;
    padding: 6px !important;
  }
  .profile-dropdown .user-info {
    padding: 10px 14px 10px;
    border-bottom: 1px solid #EDEAE5;
    margin-bottom: 4px;
  }
  .profile-dropdown .user-info .uname { font-weight: 600; font-size: 13px; color: #1A1714; }
  .profile-dropdown .user-info .uemail { font-size: 11px; color: #8A8480; }
  .profile-dropdown .dropdown-item {
    font-size: 13px;
    border-radius: 8px;
    padding: 8px 14px;
    color: #1A1714;
  }
  .profile-dropdown .dropdown-item:hover { background: #F9F7F4; }
  .profile-dropdown .dropdown-item.danger { color: #E8453C; }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- Explore link -->
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Search bar -->
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
          <input type="search" class="form-control me-2 search-inp" placeholder="Search destinations">
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>

      <!-- Right side nav -->
      <div class="navbar-nav ms-auto d-flex align-items-center gap-2">

        <% if(!currUser) { %>
          <!-- Not logged in -->
          <a class="nav-link" href="/listings/new">Add new listings</a>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log In</b></a>
        <% } %>

        <% if(currUser) { %>
          <!-- Add listing link -->
          <a class="nav-link" href="/listings/new">Add new listings</a>

          <!-- Profile dropdown -->
          <div class="dropdown">
            <button class="profile-btn dropdown-toggle-none" type="button" 
                    data-bs-toggle="dropdown" aria-expanded="false"
                    style="background:transparent;border:1.5px solid #EDEAE5;border-radius:999px;padding:4px 10px 4px 6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
              
              <i class="fa-solid fa-bars hamburger" style="font-size:14px;color:#555;"></i>

              <!-- Avatar with first letter -->
              <div class="profile-avatar">
                <%= currUser.username[0].toUpperCase() %>
              </div>
            </button>

            <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
              <!-- User info -->
              <li class="user-info">
                <div class="uname">@<%= currUser.username %></div>
                <div class="uemail"><%= currUser.email %></div>
              </li>

              <!-- My Bookings -->
              <li>
                <a class="dropdown-item" href="/bookings">
                  🧳 My Bookings
                </a>
              </li>

              <!-- Add Listing -->
              <li>
                <a class="dropdown-item" href="/listings/new">
                  ➕ Add Listing
                </a>
              </li>

              <li><hr class="dropdown-divider my-1"></li>

              <!-- Logout -->
              <li>
                <a class="dropdown-item danger" href="/logout">
                  🚪 Log Out
                </a>
              </li>
            </ul>
          </div>
        <% } %>

      </div>
    </div>
  </div>
</nav>
